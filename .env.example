# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
#
# 値は Supabase ダッシュボード → Project Settings → API から取得できます。
# ここに入れるのは「公開しても安全な」anon キーだけ。
# ★ service_role キーは絶対にここ（＝Git）に入れないこと。

# Supabase プロジェクトの URL（例: https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Supabase の anon / public キー（公開キー。ブラウザに載る前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
